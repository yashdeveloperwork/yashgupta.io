---
import Base from '../layouts/Base.astro';
---

<Base title="Not found">
  <section>
    <p class="eyebrow">404</p>
    <h1>This page is out of stock.</h1>
    <p class="muted">The page you're looking for doesn't exist. <a href="/">Head back home</a>.</p>
  </section>
</Base>

<style>
  section {
    padding: 4rem 0;
  }
  h1 {
    font-size: 2.2rem;
    margin: 0 0 0.75rem;
  }
</style>
