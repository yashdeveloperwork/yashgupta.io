---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();
---

<Base title="Blog" description="Writing on e-commerce engineering, retail systems and the craft of building software.">
  <header>
    <h1>Blog</h1>
    <p class="muted">
      Notes on e-commerce engineering, retail systems and the craft of building software.
      <a href="/rss.xml">Subscribe via RSS</a>.
    </p>
  </header>
  {posts.length ? <PostList posts={posts} /> : <p class="muted">First post coming soon.</p>}
</Base>

<style>
  header {
    padding: 2rem 0 1.5rem;
  }
  h1 {
    font-size: 2.4rem;
    margin: 0 0 0.5rem;
  }
  header p {
    margin: 0;
  }
</style>
