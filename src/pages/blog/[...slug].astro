---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts, formatDate } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, updatedDate, tags } = post.data;
---

<Base title={title} description={description} type="article">
  <article>
    <header>
      <a href="/blog" class="back muted">← All posts</a>
      <h1>{title}</h1>
      <p class="meta">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {updatedDate && <span> · Updated {formatDate(updatedDate)}</span>}
        {tags.length > 0 && <span> · {tags.join(', ')}</span>}
      </p>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  header {
    padding: 2rem 0 1rem;
  }
  .back {
    font-size: 0.875rem;
    text-decoration: none;
  }
  h1 {
    font-size: clamp(1.9rem, 5vw, 2.6rem);
    margin: 1rem 0 0.75rem;
  }
  .meta {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted);
  }
  .prose {
    margin-top: 1.5rem;
  }
  .prose :global(h2) {
    font-size: 1.5rem;
    margin: 2.5rem 0 0.75rem;
  }
  .prose :global(h3) {
    font-size: 1.2rem;
    margin: 2rem 0 0.5rem;
  }
  .prose :global(a) {
    text-decoration-color: var(--accent);
  }
  .prose :global(blockquote) {
    margin: 1.5rem 0;
    padding-left: 1rem;
    border-left: 3px solid var(--accent);
    color: var(--muted);
  }
  .prose :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
  }
  .prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--border);
    margin: 2.5rem 0;
  }
</style>
