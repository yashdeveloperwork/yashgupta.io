---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { site, about, stats } from '../data/site';
import { getPosts } from '../lib/posts';

const recent = (await getPosts()).slice(0, 3);
---

<Base>
  <section class="hero">
    <p class="eyebrow">{site.role} @ Target · {site.location}</p>
    <h1>Hi, I'm {site.name}.<br /><span>{site.tagline}</span></h1>
    <p class="intro">{site.intro}</p>
    <div class="cta">
      <a class="btn primary" href="/resume">View resume</a>
      <a class="btn" href="/blog">Read the blog</a>
    </div>
  </section>

  <ul class="stats" aria-label="Highlights">
    {
      stats.map((s) => (
        <li>
          <strong>{s.value}</strong>
          <span>{s.label}</span>
        </li>
      ))
    }
  </ul>

  <section>
    <h2 class="eyebrow">About</h2>
    {about.map((p) => <p>{p}</p>)}
  </section>

  <section>
    <div class="section-head">
      <h2 class="eyebrow">Recent writing</h2>
      <a href="/blog" class="muted">All posts →</a>
    </div>
    {recent.length ? <PostList posts={recent} /> : <p class="muted">First post coming soon.</p>}
  </section>

  <section>
    <h2 class="eyebrow">Get in touch</h2>
    <p>
      The best way to reach me is <a href={`mailto:${site.email}`}>email</a>. You can also find me on
      <a href={site.links.github}>GitHub</a>{
        site.links.linkedin && (
          <>
            {' '}and <a href={site.links.linkedin}>LinkedIn</a>
          </>
        )
      }.
    </p>
  </section>
</Base>

<style>
  .hero {
    padding: 3.5rem 0 1.5rem;
  }
  h1 {
    font-size: clamp(2.1rem, 6vw, 3.1rem);
    margin: 0 0 1.25rem;
  }
  h1 span {
    color: var(--muted);
    font-weight: 500;
  }
  .intro {
    font-size: 1.15rem;
    max-width: 36rem;
    margin: 0;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .btn {
    padding: 0.6rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 500;
  }
  .btn.primary {
    background: var(--text);
    color: var(--bg);
    border-color: var(--text);
  }
  .btn.primary:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg);
  }
  section {
    margin-top: 3.5rem;
  }
  .stats {
    list-style: none;
    padding: 0;
    margin: 2.5rem 0 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
  }
  .stats li {
    padding: 1rem 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .stats li + li {
    border-left: 1px solid var(--border);
  }
  .stats strong {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    font-weight: 600;
    color: var(--accent);
    line-height: 1.1;
  }
  .stats span {
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--muted);
  }
  @media (max-width: 600px) {
    .stats {
      grid-template-columns: 1fr 1fr;
    }
    .stats li + li {
      border-left: 0;
    }
    .stats li:nth-child(even) {
      border-left: 1px solid var(--border);
    }
    .stats li:nth-child(n + 3) {
      border-top: 1px solid var(--border);
    }
  }
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .section-head a {
    font-size: 0.875rem;
    text-decoration: none;
  }
</style>
