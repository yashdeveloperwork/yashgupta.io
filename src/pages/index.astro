---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { site, about } from '../data/site';
import { getPosts } from '../lib/posts';

const recent = (await getPosts()).slice(0, 3);
---

<Base>
  <section class="hero">
    <p class="eyebrow">{site.role} · E-commerce & Retail</p>
    <h1>Hi, I'm {site.name}.<br /><span>{site.tagline}</span></h1>
    <p class="intro">{site.intro}</p>
    <div class="cta">
      <a class="btn primary" href="/resume">View resume</a>
      <a class="btn" href="/blog">Read the blog</a>
    </div>
  </section>

  <section>
    <h2 class="eyebrow">About</h2>
    {about.map((p) => <p>{p}</p>)}
  </section>

  <section>
    <div class="section-head">
      <h2 class="eyebrow">Recent writing</h2>
      <a href="/blog" class="muted">All posts →</a>
    </div>
    {recent.length ? <PostList posts={recent} /> : <p class="muted">First post coming soon.</p>}
  </section>

  <section>
    <h2 class="eyebrow">Get in touch</h2>
    <p>
      Best way to reach me is <a href={`mailto:${site.email}`}>email</a>. You can also find me on
      <a href={site.links.github}>GitHub</a> and <a href={site.links.linkedin}>LinkedIn</a>.
    </p>
  </section>
</Base>

<style>
  .hero {
    padding: 3.5rem 0 1.5rem;
  }
  h1 {
    font-size: clamp(2.1rem, 6vw, 3.1rem);
    margin: 0 0 1.25rem;
  }
  h1 span {
    color: var(--muted);
    font-weight: 500;
  }
  .intro {
    font-size: 1.15rem;
    max-width: 36rem;
    margin: 0;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .btn {
    padding: 0.6rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 500;
  }
  .btn.primary {
    background: var(--text);
    color: var(--bg);
    border-color: var(--text);
  }
  .btn.primary:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg);
  }
  section {
    margin-top: 3.5rem;
  }
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .section-head a {
    font-size: 0.875rem;
    text-decoration: none;
  }
</style>
